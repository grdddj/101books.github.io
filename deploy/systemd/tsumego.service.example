[Unit]
Description=101 Books Go problem reader
After=network.target

[Service]
Type=simple
User=tsumego
Group=tsumego
WorkingDirectory=/opt/101books.github.io
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=UV_PROJECT_ENVIRONMENT=/var/lib/tsumego/.venv
Environment=UV_CACHE_DIR=/var/lib/tsumego/.cache/uv
ExecStart=/usr/bin/env uv run python -m reader.server --host 127.0.0.1 --port 8123 --base-path /tsumego --data-dir /var/lib/tsumego
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tsumego

[Install]
WantedBy=multi-user.target
